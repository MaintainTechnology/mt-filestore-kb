# ─────────────────────────────────────────────────────────────
#  Maintain Technology File Store KB — environment template
#  Copy this file to ".env" and fill in the values.
# ─────────────────────────────────────────────────────────────

# Port the server listens on. Railway injects PORT automatically — leave
# this for local dev only.
PORT=3000

# Knowledge Base API key — clients send this in the "x-api-key" header to
# call any /v1 endpoint. Same variable name as the NGM gemini-file-search-api
# and ngm-pinecone-ragapi so one value can gate every KB service.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KB_API_KEY=8IhHGzumrDKrXQSSkNZE8nHbSRwoP92HIzjfHRs206uWK6Te0YIQyw

# ── Gemini ───────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyBWvTDdoQCd2i-31bJZOpmMk3UzMgy1_bY

# Gemini REST API base URL.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Model used to answer questions.
GEMINI_MODEL=gemini-2.5-flash

# Optional embedding model. Blank = API default.
# "models/gemini-embedding-2" enables image indexing.
GEMINI_EMBEDDING_MODEL=

# ── Google Drive (service account) ───────────────────────────
# Path to a service-account JSON key file. Leave blank to disable Drive.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Or paste the service-account JSON inline on one line:
# GOOGLE_SERVICE_ACCOUNT_JSON=
